# ---------------------------------------------------------------------------
# Rescue Nearby — environment configuration
# Copy to `.env` and edit. Never commit `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Where the SQLite file and uploaded photos live. Defaults to <repo>/data
# DATABASE_FILE=./data/rescue.db
# DATA_DIR=./data

# Extra browser origins allowed to call the API. Only needed when the frontend
# is hosted separately from the API (in production the server serves the SPA, so
# same-origin applies and this can be left alone).
# CORS_ORIGINS=https://rescue.example.org

# --- Admin panel security ----------------------------------------------------
# Generate a hash with:
#   npm run make-password --workspace server -- "your strong password"
# then paste the output here and DELETE any ADMIN_PASSWORD line.
#
# ADMIN_PASSWORD_SCRYPT=

# Development-only fallback. If set, it is hashed in memory at boot. The server
# prints a loud warning if this is missing or set to the default "admin123".
# ADMIN_PASSWORD=admin123
ADMIN_USERNAME=admin

# Signs the admin session cookie. If unset, a random one is generated per boot,
# which silently logs admins out on every restart. REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

ADMIN_SESSION_TTL_HOURS=12

# --- Data quality -----------------------------------------------------------
# While this is not "false", the UI shows "sample data" warnings and the
# helpline banner shows a pre-launch caution. Only set to false once every
# organisation has been verified by phone.
# DIRECTORY_IS_SAMPLE_DATA=false

# --- Live veterinary lookup (hybrid directory) ------------------------------
# Curated NGOs and municipal helplines are hand-verified. Veterinary clinics are
# looked up live from OpenStreetMap via the Overpass API, so any city has vet
# coverage without anyone typing clinics into a spreadsheet.
#
# Set to false to serve only the hand-curated directory. Nothing else breaks:
# the UI simply stops showing "From OpenStreetMap" results and the unavailable
# warning never appears.
LIVE_LOOKUP_ENABLED=true

# The Overpass instance to query. The default is fine for light traffic, but it
# is a shared free service with rate limits. For real deployments run your own:
#   docker run -d -p 8080:80 -e OVERPASS_META=yes wiktorn/overpass-api
# then point this at http://localhost:8080/api/interpreter (via a reverse proxy).
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# How long one grid cell's results stay fresh. 24h keeps a clinic's phone
# number current for roughly a day without hammering the API.
LIVE_LOOKUP_CACHE_TTL_HOURS=24

# Search radius for the live lookup, in km. A user can request less via
# ?radiusKm=, but never more than this.
LIVE_LOOKUP_RADIUS_KM=10

# Hard cap on a single Overpass request, in milliseconds. If Overpass is slow or
# down, the request is abandoned and the user still gets their curated results.
LIVE_LOOKUP_TIMEOUT_MS=3000

# Overpass's fair-use policy asks every client to identify itself. The default
# identifies this app; set your own contact so operators can reach you.
# OVERPASS_USER_AGENT=RescueNearby/1.0 (+https://your-domain.org)
